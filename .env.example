# Auto Data Analyst - LLM Configuration
# Copy this file to ".env" and fill in your API key.

# --- Required: Your API key (OpenAI-compatible) ---
LLM_API_KEY=your-api-key-here

# --- Optional settings ---
# LLM provider: openai, groq, together, mistral, local, etc.
# For OpenAI-compatible providers, you can set a custom base URL.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Alternative: OpenAI key fallback ---
# OPENAI_API_KEY=your-openai-key-here
